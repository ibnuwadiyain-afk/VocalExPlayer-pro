{
  "expo": {
    "name": "VocalExtractor",
    "slug": "vocal-extractor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#121212"
    },
    "assetBundlePatterns": [
      "assets/models/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.aistudio.vocalextractor.uxptvz",
      "permissions": [
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VocalExtractor to access your videos for AI vocal separation."
        }
      ]
    ]
  }
}
